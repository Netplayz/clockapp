Read count from input (ASCII digit), output tick/tock alternating that many times
Tape: [count][counter][value]

,------------------------------------------------  read input char, subtract 48 to get count
[                                                    while count != 0
  t=116: >++++++++++[>+++++++++++<-]>++++++.  [-]<[-]<
  i=105: >++++++++++[>+++++++++++<-]>+++++.   [-]<[-]<
  c=99:  >++++++++++[>++++++++++<-]>-.        [-]<[-]<
  k=107: >++++++++++[>+++++++++++<-]>---.     [-]<[-]<
  \n=10: >++++++++++.                          [-]<
  t=116: >++++++++++[>+++++++++++<-]>++++++.  [-]<[-]<
  o=111: >++++++++++[>+++++++++++<-]>+.       [-]<[-]<
  c=99:  >++++++++++[>++++++++++<-]>-.        [-]<[-]<
  k=107: >++++++++++[>+++++++++++<-]>---.     [-]<[-]<
  \n=10: >++++++++++.                          [-]<
  -                                                    decrement count
]
